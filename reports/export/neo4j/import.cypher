// Generated by cyberintel.graph_analysis.export_neo4j. Copy the CSVs to Neo4j's import/ folder, then run this script.
CREATE CONSTRAINT entity_id IF NOT EXISTS FOR (n:Node) REQUIRE n.id IS UNIQUE;
LOAD CSV WITH HEADERS FROM 'file:///nodes.csv' AS r
MERGE (n:Node {id: r.id}) SET n.type = r.type, n.label = r.label, n.category = r.category,
  n.n_incidents = toInteger(r.n_incidents), n.kb_name = r.kb_name, n.kb_summary = r.kb_summary;
MATCH (n:Node) WHERE n.type = 'INCIDENT' SET n:Incident;
MATCH (n:Node) WHERE n.type <> 'INCIDENT' SET n:Entity;
LOAD CSV WITH HEADERS FROM 'file:///edges_AFFECTS.csv' AS r
MATCH (a:Node {id: r.source}), (b:Node {id: r.target})
MERGE (a)-[e:AFFECTS]->(b) SET e.weight = toFloat(r.weight), e.support = toInteger(r.support), e.lift = toFloat(r.lift),
  e.origin = r.origin, e.status = r.status, e.evidence = r.evidence;
LOAD CSV WITH HEADERS FROM 'file:///edges_ALIAS_OF.csv' AS r
MATCH (a:Node {id: r.source}), (b:Node {id: r.target})
MERGE (a)-[e:ALIAS_OF]->(b) SET e.weight = toFloat(r.weight), e.support = toInteger(r.support), e.lift = toFloat(r.lift),
  e.origin = r.origin, e.status = r.status, e.evidence = r.evidence;
LOAD CSV WITH HEADERS FROM 'file:///edges_EXPLOITS.csv' AS r
MATCH (a:Node {id: r.source}), (b:Node {id: r.target})
MERGE (a)-[e:EXPLOITS]->(b) SET e.weight = toFloat(r.weight), e.support = toInteger(r.support), e.lift = toFloat(r.lift),
  e.origin = r.origin, e.status = r.status, e.evidence = r.evidence;
LOAD CSV WITH HEADERS FROM 'file:///edges_MAPS_TO.csv' AS r
MATCH (a:Node {id: r.source}), (b:Node {id: r.target})
MERGE (a)-[e:MAPS_TO]->(b) SET e.weight = toFloat(r.weight), e.support = toInteger(r.support), e.lift = toFloat(r.lift),
  e.origin = r.origin, e.status = r.status, e.evidence = r.evidence;
LOAD CSV WITH HEADERS FROM 'file:///edges_MENTIONS.csv' AS r
MATCH (a:Node {id: r.source}), (b:Node {id: r.target})
MERGE (a)-[e:MENTIONS]->(b) SET e.weight = toFloat(r.weight), e.support = toInteger(r.support), e.lift = toFloat(r.lift),
  e.origin = r.origin, e.status = r.status, e.evidence = r.evidence;
LOAD CSV WITH HEADERS FROM 'file:///edges_MITIGATES.csv' AS r
MATCH (a:Node {id: r.source}), (b:Node {id: r.target})
MERGE (a)-[e:MITIGATES]->(b) SET e.weight = toFloat(r.weight), e.support = toInteger(r.support), e.lift = toFloat(r.lift),
  e.origin = r.origin, e.status = r.status, e.evidence = r.evidence;
LOAD CSV WITH HEADERS FROM 'file:///edges_SIMILAR_TO.csv' AS r
MATCH (a:Node {id: r.source}), (b:Node {id: r.target})
MERGE (a)-[e:SIMILAR_TO]->(b) SET e.weight = toFloat(r.weight), e.support = toInteger(r.support), e.lift = toFloat(r.lift),
  e.origin = r.origin, e.status = r.status, e.evidence = r.evidence;
LOAD CSV WITH HEADERS FROM 'file:///edges_TARGETS.csv' AS r
MATCH (a:Node {id: r.source}), (b:Node {id: r.target})
MERGE (a)-[e:TARGETS]->(b) SET e.weight = toFloat(r.weight), e.support = toInteger(r.support), e.lift = toFloat(r.lift),
  e.origin = r.origin, e.status = r.status, e.evidence = r.evidence;
LOAD CSV WITH HEADERS FROM 'file:///edges_USES.csv' AS r
MATCH (a:Node {id: r.source}), (b:Node {id: r.target})
MERGE (a)-[e:USES]->(b) SET e.weight = toFloat(r.weight), e.support = toInteger(r.support), e.lift = toFloat(r.lift),
  e.origin = r.origin, e.status = r.status, e.evidence = r.evidence;
